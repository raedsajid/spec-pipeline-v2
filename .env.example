# Database (Turso/libSQL)
# Create a Turso database and copy its URL/token here and into Vercel.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-token

# Cloudflare R2 object storage (S3-compatible API)
R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=builderp

# Application secrets/settings
# Generate a strong random value and KEEP IT STABLE across deployments.
SETTINGS_SECRET=replace-with-a-long-random-secret
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# The Gemini API key itself is still saved from the BuildERP Settings screen.
